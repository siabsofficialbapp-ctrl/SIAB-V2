# ============================================================================
# SIAB — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase
# Project dashboard -> Settings -> API
# ---------------------------------------------------------------------------
# PUBLIC — safe to ship inside the mobile/web client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# SECRET — server only (apps/api). Bypasses Row Level Security.
# If this ever reaches the client, every seller's private data is exposed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Used by the API to verify incoming Supabase JWTs locally.
# Dashboard -> Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Anthropic (powers both the Customer AI and the Private AI Coworker)
# ---------------------------------------------------------------------------
# SECRET — server only. Never bundle into the client.
ANTHROPIC_API_KEY=sk-ant-...
# Model used for both assistants. See docs/AI.md for the cost/quality tradeoff.
SIAB_AI_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Brevo — transactional email (account verification, notifications)
# ---------------------------------------------------------------------------
# SECRET — server only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@siab.app
BREVO_SENDER_NAME=SIAB

# ---------------------------------------------------------------------------
# API service (deployed to Railway)
# ---------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
# Comma-separated list of origins allowed to call the API.
API_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
# Public base URL of the API, used by the client apps.
API_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Payments — provider-agnostic.
# No live gateway is wired yet. `mock` runs the full order/payment state
# machine against an in-process sandbox so nothing is faked at the data layer.
# Switch to `moyasar` / `tap` once a Saudi merchant account exists.
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=mock
PAYMENTS_CURRENCY=SAR
PAYMENTS_WEBHOOK_SECRET=
# MOYASAR_SECRET_KEY=
# TAP_SECRET_KEY=

# ---------------------------------------------------------------------------
# Platform economics
# ---------------------------------------------------------------------------
# Saudi VAT, in basis points (1500 = 15%). Prices shown to buyers are
# VAT-inclusive, as Saudi consumer-pricing rules require.
SIAB_VAT_BPS=1500
# Platform commission on each sale, in basis points (100 = 1%).
SIAB_PLATFORM_FEE_BPS=100

# ---------------------------------------------------------------------------
# Client-side (Expo). Only PUBLIC values may live here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_API_URL=http://localhost:8080
